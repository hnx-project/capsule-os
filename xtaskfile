[project]
name = "capsuleOS"
version = "1.0.0-beta4"
codename = "Pangu"

[run.qemu]
bin = "qemu-system-aarch64"
smp = 4
args = [
    "-M", "virt,secure=off",
    "-cpu", "cortex-a72",
    "-smp", "{smp}",
    "-m", "512M",
    "-bios", "{uefi_bios}",
    "-drive", "file=fat:rw:{efi_dir},media=disk,format=raw",
    "-drive", "file=fat:rw:{rootfs_dir},media=disk,format=raw",
    "-nographic"
]

[build]
bootloader = { path = 'bootloader/uefi/Cargo.toml', output = '{BUILD_TEMP_EFI}/EFI/BOOT/BOOTAA64.EFI' }
kernel     = { path = 'mcore/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/boot/KERNEL' }

pillsmod = [
    { path = 'userspace/addons/hello_pill/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/extensions/*.pillsmod' }
]

services = [
    { path = 'userspace/services/loader/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/system/bin/loader' },
    { path = 'userspace/services/servicesd/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/system/bin/servicesd' },
    { path = 'userspace/services/fileagent/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/system/bin/fileagent' },
    { path = 'userspace/services/procmgr/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/system/bin/procmgr' },
    { path = 'userspace/services/devmgr/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/system/bin/devmgr' },
    { path = 'userspace/services/netd/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/system/bin/netd' },
    { path = 'userspace/services/gpud/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/system/bin/gpud' },
    { path = 'userspace/services/inputd/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/system/bin/inputd' },
    { path = 'userspace/services/touchd/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/system/bin/touchd' }
]

apps = [
    { path = 'userspace/programs/osh/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/bin/osh' },
    { path = 'userspace/programs/ls/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/bin/ls' },
    { path = 'userspace/programs/cat/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/bin/cat' },
    { path = 'userspace/programs/mkdir/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/bin/mkdir' },
    { path = 'userspace/programs/touch/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/bin/touch' },
    { path = 'userspace/programs/rm/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/bin/rm' },
    { path = 'userspace/programs/rmdir/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/bin/rmdir' },
    { path = 'userspace/programs/ps/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/bin/ps' },
    { path = 'userspace/programs/kill/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/bin/kill' },
    { path = 'userspace/programs/testall/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/bin/testall' },
    { path = 'userspace/programs/dmesg/Cargo.toml', output = '{BUILD_TEMP_ROOTFS}/bin/dmesg' }
]
